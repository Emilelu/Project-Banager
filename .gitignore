~$*!.xlsx
node_modules
**/uploads/*
**/.vscode
**/bangumi.db

# 本地工作数据（AI 会话记忆/日志），不入库
.workbuddy/

# 临时脚本目录（配合 scripts/run.mjs 使用）
# 为什么单独建这个目录：PowerShell 5.1 会把 node -e 里的反引号/$/&&/|| 破坏，
# 所以凡是带中文、模板串、正则的脚本都必须先写成文件再执行。
# 这些文件是一次性的，不应入库。
tmp/
tests/e2e/_*.mjs
tests/e2e/_*.png
tests/e2e/_export/
tests/e2e/_rt/
